# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key — full read/write access, bypasses Row Level Security.
# Server-side only. Must never be imported into a client component or exposed
# to the browser in any way.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployed site (used for metadata, canonical URLs, etc.).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
