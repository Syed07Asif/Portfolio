# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# claude code
.claude/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real secrets)
.env
.env*.local
.env.development
.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local media (uploaded content should live in Supabase Storage, not the repo)
/public/uploads

# Supabase CLI local dev state (created by `supabase start`/`db reset`)
supabase/.branches
supabase/.temp
supabase/snippets

# Playwright output — traces, failure screenshots, and the responsive
# screenshot set (screenshots/responsive/<browser>/, ~11MB per browser). These are
# artifacts to look at locally, regenerated by `npx playwright test`, and
# deliberately not committed.
/test-results
/screenshots
/playwright-report
/playwright/.cache
